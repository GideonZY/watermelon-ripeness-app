<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_header"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="西瓜图标"
                android:src="@drawable/ic_watermelon_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="挑个好西瓜"
                    android:textColor="#173B2A"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="轻拍三下，听声音帮你判断值不值得买"
                    android:textColor="#4F6B5A"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/instructionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_surface"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="怎么测"
                android:textColor="#173B2A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="1  靠近西瓜中部 · 手机距离瓜面约 10～20 cm&#10;2  连续轻拍三下 · 正常连续拍，不用等提示&#10;3  自动给出建议 · 检测稳定才会给结论"
                android:textColor="#4F6B5A"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordButton"
            style="@style/Widget.Watermelon.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="开始检测"
            android:textSize="18sp"
            app:cornerRadius="18dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="正在检测，请连续轻拍西瓜中部"
            android:textColor="#587262"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/liveDetectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="听到有效拍击时，指针会明显响应"
                android:textColor="#5B7465"
                android:textSize="13sp" />

            <com.example.watermelonripeness.ui.RipenessGaugeView
                android:id="@+id/ripenessGauge"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/liveFrequencyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="正在听…"
                android:textColor="#244A39"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_result"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="购买建议"
                android:textColor="#6A8374"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="推荐购买"
                android:textColor="@color/result_recommend"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultRipeness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="适熟"
                android:textColor="#244A39"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultStability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_result_badge"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="检测稳定"
                android:textColor="#315E45"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:lineSpacingExtra="4dp"
                android:text="三次拍击的共振与衰减特征较一致，更接近适熟区间。"
                android:textColor="#405B4B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/resultReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="声音参考值：148 Hz"
                android:textColor="#789082"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="声音会受品种、敲击位置和力度影响，结果用于辅助挑选。"
                android:textColor="#87998F"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
